# Copiez ce fichier en « .env.local » puis remplacez les valeurs.
# Ces deux valeurs sont PUBLIQUES (protégées par les règles RLS de la base).
# Ne mettez JAMAIS ici la clé secrète « service_role » / « secret ».
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Étape 8 — RevenueCat : clés PUBLIQUES du SDK (une par plateforme).
# La clé SECRÈTE RevenueCat ne va JAMAIS ici : elle est enregistrée côté serveur
# (npx supabase secrets set REVENUECAT_SECRET_API_KEY=...).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Liens affichés sur la page Premium (obligatoires pour l'App Store).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
