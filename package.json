    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "bash scripts/e2e-web.sh",
    "test:functions": "DENO_BIN=${DENO_BIN:-$(command -v deno || echo \"npx -y deno@2\")} node supabase/functions/_tests/webhook.integration.mjs && DENO_BIN=${DENO_BIN:-$(command -v deno || echo \"npx -y deno@2\")} node supabase/functions/_tests/assistant.integration.mjs && DENO_BIN=${DENO_BIN:-$(command -v deno || echo \"npx -y deno@2\")} node supabase/functions/_tests/delete-account.integration.mjs",
    "sync:functions": "cp src/features/schedule/logic.ts supabase/functions/_shared/app/schedule-logic.ts && cp src/features/goals/logic.ts supabase/functions/_shared/app/goals-logic.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|lucide-react-native|react-native-svg)"
    ]
  }
