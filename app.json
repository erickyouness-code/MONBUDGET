{
  "expo": {
    "name": "MonBudget",
    "slug": "monbudget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monbudget.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B4FE0",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundImage": "./assets/brand/android-background.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.monbudget.app"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MonBudget utilise Face ID pour protéger l’accès à vos données financières."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4FE0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#F6F6FB",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#0E0D1A"
          }
        }
      ]
    ],
    "scheme": "monbudget"
  }
}
